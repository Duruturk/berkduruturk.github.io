<script>
(function () {
  const main = document.querySelector('main');
  const sections = [...main.querySelectorAll('section')];
  const nav = document.querySelector('nav.jump');
  const buttons = document.querySelectorAll('.toggle button');

  function setView(view) {
    sections.forEach(s => {
      const v = s.dataset[view];
      const hide = !v || v === '-';
      s.hidden = hide;
      s.style.order = hide ? 999 : v;
    });
    document.querySelectorAll('[data-only]').forEach(el => {
      el.hidden = el.dataset.only !== view;
    });
    const visible = sections.filter(s => !s.hidden)
      .sort((a, b) => a.style.order - b.style.order);
    nav.innerHTML = visible.map(s => `<a href="#${s.id}">${s.dataset.title}</a>`).join('');
    updateActive();
    buttons.forEach(b => b.setAttribute('aria-pressed', b.dataset.view === view));
    // Keep ?view= in the address bar (skipped where the browser doesn't allow it, e.g. previews)
    try {
      const url = new URL(location);
      url.searchParams.set('view', view);
      history.replaceState(null, '', url);
    } catch (e) {}
  }


  // Highlight the section currently in view
  function updateActive() {
    const links = [...nav.querySelectorAll('a')];
    if (!links.length) return;
    let current = links[0];
    const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4;
    for (const a of links) {
      const sec = document.querySelector(a.getAttribute('href'));
      if (sec && sec.getBoundingClientRect().top <= 120) current = a;
    }
    if (atBottom) current = links[links.length - 1];
    links.forEach(a => a.classList.toggle('active', a === current));
  }
  window.addEventListener('scroll', updateActive, { passive: true });
  window.addEventListener('resize', updateActive);

  buttons.forEach(b => b.addEventListener('click', () => setView(b.dataset.view)));
  const initial = new URLSearchParams(location.search).get('view');
  setView(initial === 'industry' ? 'industry' : 'academic');

  // School logos: if an image file is missing, show a small initials badge instead
  document.querySelectorAll('img.school-logo').forEach(img => {
    const fallback = () => {
      const b = document.createElement('span');
      b.className = 'logo-fallback'; b.textContent = img.dataset.initials || '';
      b.setAttribute('aria-hidden', 'true'); img.replaceWith(b);
    };
    if (img.complete && img.naturalWidth === 0) fallback(); else img.addEventListener('error', fallback);
  });

  // Topic filters: each .chips filters the list items inside its own section
  const label = t => t.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase())
                      .replace(/\bGis\b/, 'GIS').replace(/\bSets\b/, 'Sets');
  document.querySelectorAll('.chips').forEach(chips => {
    const items = [...chips.closest('section').querySelectorAll('ol.pubs li')];
    const topics = [...new Set(items.flatMap(li => (li.dataset.topic || '').split(/\s+/).filter(Boolean)))];
    if (topics.length < 2) { chips.remove(); return; }
    chips.innerHTML = ['all', ...topics].map(t =>
      `<button type="button" data-t="${t}" aria-pressed="${t === 'all'}">${t === 'all' ? 'All' : label(t)}</button>`
    ).join('');
    chips.addEventListener('click', e => {
      const btn = e.target.closest('button'); if (!btn) return;
      const t = btn.dataset.t;
      chips.querySelectorAll('button').forEach(b => b.setAttribute('aria-pressed', b === btn));
      items.forEach(li => {
        li.hidden = t !== 'all' && !(li.dataset.topic || '').split(/\s+/).includes(t);
      });
    });
  });
})();
</script>
